# Secrets et configuration locale
config.toml
.env

# Tokens / cookies de session (CAPI OAuth2, etc.)
*.token.json
.capi_token.json
*.cookies

# Certificat TLS auto-signé du serveur de callback local CAPI (dev uniquement)
