*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Dumps de journal personnel copiés pour test
journal_samples/
*.journal_dump/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.idea/
.vscode/
